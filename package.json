{
  "name": "cloudflare-ti-ioc-sync",
  "version": "1.0.0",
  "description": "Cloudflare Worker that syncs OSINT threat-intelligence feeds into Zero Trust Gateway domain/URL lists, with a live dashboard",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
